{
  "name": "social-portfolio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run chat:knowledge && vite build && node scripts/prerender.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "vite preview",
    "chat:knowledge": "node scripts/generate-chat-knowledge.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:chat": "npm run build && wrangler dev --env local --ip 127.0.0.1 --port 8787",
    "check:worker": "tsc -p tsconfig.worker.json",
    "check:seo": "node scripts/check-seo.mjs",
    "deploy": "npm run build && wrangler deploy --env=\"\"",
    "deploy:dry-run": "npm run build && wrangler deploy --env=\"\" --dry-run",
    "predev": "npm run chat:knowledge",
    "pretest": "npm run chat:knowledge",
    "pretypecheck": "npm run chat:knowledge",
    "precheck:worker": "npm run chat:knowledge"
  },
  "dependencies": {
    "framer-motion": "^11.5.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.2.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  }
}
